; How many references of the listed base forms lie within afRadius of akCenter, how many of the forms are
; present, how many resolved at all (a list that does not resolve cannot find anything), and the nearest.
String Function Count(ObjectReference akCenter, Int[] aiIds, Float afRadius) global
    Int resolved = 0
    Int refs = 0
    Int types = 0
    Float nearest = -1.0
    String which = ""
    Int i = 0
    While i < aiIds.Length
        Form f = Game.GetFormFromFile(aiIds[i], "Starfield.esm")
        If f
            resolved += 1
            ObjectReference[] found = akCenter.FindAllReferencesOfType(f, afRadius)
            If found.Length > 0
                refs += found.Length
                types += 1
                If types <= 12
                    which += " " + i
                EndIf
                Int j = 0
                While j < found.Length
                    Float d = akCenter.GetDistance(found[j])
                    If nearest < 0.0 || d < nearest
                        nearest = d
                    EndIf
                    j += 1
                EndWhile
            EndIf
        EndIf
        i += 1
    EndWhile
    Return "" + refs + " refs of " + types + " types (" + resolved + " of " + aiIds.Length + " resolved), nearest " + (nearest as Int) + "\n   list index:" + which
EndFunction

Function Run(float afRadius = 0.0) global
    Float radius = afRadius
    If radius <= 0.0
        radius = 500.0
    EndIf
    Actor player = Game.GetPlayer()
    Int[] pivot = new Int[1]
    pivot[0] = 0x03F808 ; PrefabPackinPivotDummy
    String out = "MANMADE PROBE  radius " + (radius as Int)
    out += "\n1 PackIns themselves: " + Count(player, PackIds(), radius)
    out += "\n2 their objects (control): " + Count(player, LeafIds(), radius)
    out += "\n3 pivot dummies: " + Count(player, pivot, radius)
    Debug.Trace(out)
    Debug.MessageBox(out)
EndFunction
