      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "This beacon\u0027s antenna feed was cracked, so it only reached a few hundred metres. I patched it and it\u0027s carrying again.",
