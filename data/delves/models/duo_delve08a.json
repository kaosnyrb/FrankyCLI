      ]
    },
    {
      "Index": 20,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "I\u0027ve found the private\u0027s letters at the \u003CAlias=ThirdLocation\u003E. They\u0027re all addressed to his sister at the \u003CAlias=DungeonLocation\u003E, so that\u0027s where they\u0027re going.",
