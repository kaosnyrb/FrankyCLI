      ]
    },
    {
      "Index": 10,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "The cache held a note from a private. His letters are stashed at the \u003CAlias=ThirdLocation\u003E, and he asks whoever finds this to see they get home.",
