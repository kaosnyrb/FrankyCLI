            "Lines": [
              {
                "WEMFile": 11697,
                "EmotionOut": 0,
                "ResponseText": "They hit my camp and took the lot. Most of it I can replace. There\u0027s a case of claim papers in there I can\u0027t. Without those, the ground I\u0027ve been working belongs to whoever files first.",
                "ScriptNotes": "",
                "Edits": "",
