            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 11689,
                "EmotionOut": 7.466667,
                "ResponseText": "I did. I got as far as the door, heard them laughing, and walked back out. I\u0027m not proud of it.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "612D9DB9"
              }
            ]
          }
        ]
      },
