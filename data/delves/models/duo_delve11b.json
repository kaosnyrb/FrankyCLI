            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 0,
                "EmotionOut": 7.466667,
                "ResponseText": "I found your claim papers.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "7A71A508"
              }
            ]
          }
        ]
      },
