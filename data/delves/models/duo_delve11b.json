            "Header": {
              "MajorFlags": 0,
              "FormVersion": 576,
              "Version2": 0,
              "VersionControl": 0
            },
            "EditorID": "duo_delve11b_talk2_reply2_info",
            "Speaker": "002D98:du_overtime.esm",
            "StartScenePhase": "",
            "SubtitlePriority": 1,
            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 11684,
                "EmotionOut": 7.466667,
                "ResponseText": "The drill, the food, my good boots. All of that can be bought again. The ground can\u0027t, not once somebody else files on it.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "D9E5C0AB"
              }
            ]
          }
        ]
      },
