            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 0,
                "EmotionOut": 7.466667,
                "ResponseText": "What else did they take?",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "D58D7E79"
              }
            ]
          }
        ]
      },
      {
        "FormKey": "002DA4:du_overtime.esm",
