            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 11694,
                "EmotionOut": 7.466667,
                "ResponseText": "A drill digs anywhere. These say where I\u0027m allowed to.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "E5814888"
              }
            ]
          }
