            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 0,
                "EmotionOut": 7.466667,
                "ResponseText": "Why not go in yourself?",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "925447BE"
              }
            ]
          }
        ]
      },
