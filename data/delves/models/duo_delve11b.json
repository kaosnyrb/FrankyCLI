            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 11679,
                "EmotionOut": 7.466667,
                "ResponseText": "That\u0027s them. Eleven years of survey work, and it fits in a case. Without this I\u0027m just a man standing in a hole. Thank you.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "FAE3ED07"
              }
            ]
          }
        ]
      },
