            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 0,
                "EmotionOut": 7.466667,
                "ResponseText": "Why are papers worth more than the drill?",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "1DD6D5D9"
              }
            ]
          }
        ]
