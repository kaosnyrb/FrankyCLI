      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "A survey team set three seismic sensors at the \u003CAlias=DungeonLocation\u003E and left before anyone came back to read them. The data\u0027s still in them.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
              "RewardDatas": []
