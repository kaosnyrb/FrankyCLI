      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "This sensor was still recording on its own, weeks after the team left, under a label that said PLEASE DON\u0027T MOVE ME. I copied everything it had.",
