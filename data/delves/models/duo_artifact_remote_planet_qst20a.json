      ]
    },
    {
      "Index": 10,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "This sensor had been knocked off true, with CHECK ME written on the casing. I set it level again and pulled its readings.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
