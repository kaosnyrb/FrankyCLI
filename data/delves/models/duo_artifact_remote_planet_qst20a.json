    },
    {
      "Index": 20,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "This sensor had been buried up to the lid. Someone had scratched a tally of days into it and stopped at forty. The readings were still there.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
