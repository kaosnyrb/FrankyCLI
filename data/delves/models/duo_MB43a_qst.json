            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "WEMFile": 15104,
                "EmotionOut": 0,
                "ResponseText": "You\u0027re on site? Good.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "05D301D5"
              },
              {
                "WEMFile": 15106,
                "EmotionOut": 0,
                "ResponseText": "The terminal\u0027s locked, and our lead wrote the code down somewhere near the door. She always does.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "2F898DF8"
              },
              {
                "WEMFile": 15107,
                "EmotionOut": 0,
                "ResponseText": "Mind yourself in there. Whatever ran us out hasn\u0027t left.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "1024A5AD"
              }
            ]
          }
        ]
      },
