            "Lines": [
              {
                "WEMFile": 15113,
                "EmotionOut": 0,
                "ResponseText": "That\u0027s the drive? That\u0027s the whole season.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "31EC1C3E"
              },
              {
                "WEMFile": 15115,
                "EmotionOut": 0,
                "ResponseText": "Now get out of there. Nobody\u0027s paid enough to stay.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "784FD0ED"
              }
            ]
