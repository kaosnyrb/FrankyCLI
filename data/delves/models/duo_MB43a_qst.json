            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "WEMFile": 15109,
                "EmotionOut": 0,
                "ResponseText": "You\u0027re in? Good.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "88884279"
              },
              {
                "WEMFile": 15111,
                "EmotionOut": 0,
                "ResponseText": "It says she pulled everything to a drive before they ran. It\u0027ll be in the site safe, further in.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "953AA299"
              }
            ]
          }
        ]
