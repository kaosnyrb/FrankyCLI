                "Emotion": "None",
                "WEMFile": 13620,
                "EmotionOut": 7.466667,
                "ResponseText": "They come at night and take two at a time, then carry them up to their boss. He\u0027s the one eating them.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "10B60C8F"
