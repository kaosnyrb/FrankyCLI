              {
                "WEMFile": 13641,
                "EmotionOut": 0,
                "ResponseText": "Somebody\u0027s taking my stock, two a week, always at night.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "55162139"
              },
              {
                "WEMFile": 13643,
                "EmotionOut": 0,
                "ResponseText": "I know where they\u0027re going and who\u0027s eating them. Come and see me, and I\u0027ll tell you the rest.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "F1336C76"
