            "EditorID": "duo_artifact_local_qst24a_say1_info",
            "Speaker": "003504:du_overtime.esm",
            "StartScenePhase": "",
            "SubtitlePriority": 1,
            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "WEMFile": 13573,
                "EmotionOut": 0,
                "ResponseText": "Our transport came down hard, and the pens split open. The animals ran, and they\u0027ve gone to ground at a site nearby.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "1C733B3B"
              },
              {
                "WEMFile": 13575,
                "EmotionOut": 0,
                "ResponseText": "I raised every one of those animals from the egg myself, and I know what they will do out there. Please put them down before they learn the ground.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "F788DF49"
              }
            ]
          }
        ]
      },
      {
        "FormKey": "003509:du_overtime.esm",
