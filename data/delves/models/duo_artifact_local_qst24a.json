            },
            "EditorID": "duo_artifact_local_qst24a_say2_info",
            "Speaker": "003504:du_overtime.esm",
            "StartScenePhase": "",
            "SubtitlePriority": 1,
            "COCT": false,
            "Conditions": [],
            "Lines": [
              {
                "WEMFile": 13577,
                "EmotionOut": 0,
                "ResponseText": "So every one of them went down fighting, the way their mothers did. Thank you for doing it properly, and doing it quickly.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "A94DC52C"
              },
              {
                "WEMFile": 13579,
                "EmotionOut": 0,
                "ResponseText": "I will write each of their names in the pen book tonight.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "E8C7D7A6"
              }
            ]
          }
        ]
      }
