      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "The \u003CAlias=DungeonLocation\u003E is waiting on a reclaimer housing that was signed out to them and never arrived. I should find where the crate stopped.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
