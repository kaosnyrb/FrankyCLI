      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "I\u0027ve recovered the filter core, still sealed. I should take it back to the \u003CAlias=DungeonLocation\u003E and get the reclaimer running.",
          "Conditions": [],
