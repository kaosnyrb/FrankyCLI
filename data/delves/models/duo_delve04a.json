        }
      ]
    },
    {
      "Index": 20,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "The filter core reached the \u003CAlias=DungeonLocation\u003E two days ago and was taken from its crate overnight. Without it the reclaimer stays offline. I need to find whoever took it.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
              "RewardDatas": []
