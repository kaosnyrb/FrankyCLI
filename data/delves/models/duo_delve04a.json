      ]
    },
    {
      "Index": 10,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "I found the housing crate, dropped well short of where it was going. The manifest says a filter core was sent on ahead. I should take the housing to the \u003CAlias=DungeonLocation\u003E.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
