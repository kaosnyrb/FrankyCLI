                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "4445293D"
              },
              {
                "WEMFile": 12809,
                "EmotionOut": 0,
                "ResponseText": "Get it running and keep it running until we\u0027ve copied everything.",
