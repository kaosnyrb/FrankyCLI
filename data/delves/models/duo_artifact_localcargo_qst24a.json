      ]
    },
    {
      "Index": 10,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "I found the dish crate, set down well short of the \u003CAlias=DungeonLocation\u003E. The tag says the transmitter went ahead on its own. I should take the dish there.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
              "RewardDatas": []
            }
          ]
        }
      ]
    },
    {
      "Index": 20,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "The transmitter reached the \u003CAlias=DungeonLocation\u003E and was taken from its crate before anyone could fit it. Without it the dish is just a dish. I need to find who took it.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
              "RewardDatas": []
            }
          ]
        }
      ]
    },
    {
      "Index": 30,
      "Flags": 0,
      "Unknown": 0,
      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "I\u0027ve got the transmitter back, still in its packing. I should take it to the \u003CAlias=DungeonLocation\u003E and get the relay working.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
