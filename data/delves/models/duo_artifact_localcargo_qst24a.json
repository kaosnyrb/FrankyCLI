      "LogEntries": [
        {
          "Flags": 0,
          "Entry": "The \u003CAlias=DungeonLocation\u003E has been without a comms relay for over a week. The dish was signed out to them and never arrived, so I should find where it stopped.",
          "Conditions": [],
          "StageCompleteDatas": [
            {
              "QSRD": "00000000",
              "RewardDatas": []
            },
            {
              "QSRD": "",
              "RewardDatas": []
