            "Lines": [
              {
                "Emotion": "None",
                "WEMFile": 15761,
                "EmotionOut": 7.466667,
                "ResponseText": "Raiders have been taking my cattle. They come at night, take two at a time, and drive them up to their boss. He\u0027s eating them.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "CE5A8737"
              }
            ]
          }
        ]
