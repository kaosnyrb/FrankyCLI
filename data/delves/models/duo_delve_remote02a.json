            "Lines": [
              {
                "WEMFile": 12771,
                "EmotionOut": 0,
                "ResponseText": "Our courier was jumped and had to leave a canister of cultures behind.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "68D69439"
              },
              {
                "WEMFile": 12773,
                "EmotionOut": 0,
                "ResponseText": "Bring it out and you\u0027ll be paid.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "2C2FFA43"
              },
              {
                "WEMFile": 12774,
                "EmotionOut": 0,
                "ResponseText": "They may still be watching for it.",
                "ScriptNotes": "",
                "Edits": "",
                "AlternateLipText": "",
                "TextHash": "2BC5F92E"
              }
            ]
          }
        ]
